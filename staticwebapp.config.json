{
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer"
  },
  "routes": [
    {
      "route": "/content/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/trainer.html",
      "headers": {
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "route": "/tools/*",
      "statusCode": 404
    },
    {
      "route": "/dashboard.html",
      "headers": {
        "X-Robots-Tag": "noindex",
        "Cache-Control": "no-store"
      }
    }
  ],
  "mimeTypes": {
    ".json": "application/json",
    ".svg": "image/svg+xml"
  },
  "platform": {
    "apiRuntime": "node:20"
  }
}